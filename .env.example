# Copier vers .env et remplir. .env est gitignoré.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=greenlight-xxxx
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Modèles : confirmer les identifiants exacts dans la doc Vertex AI au moment du build.
# Flash pour l'extraction (gros volume), Pro pour la classification (jugement).
GEMINI_MODEL_EXTRACT=gemini-3.1-flash
GEMINI_MODEL_CLASSIFY=gemini-3-pro

# Chemin AI Studio (free tier) : mettre GOOGLE_GENAI_USE_VERTEXAI=false et
# renseigner la clé ci-dessous. Inutile en Vertex.
GOOGLE_API_KEY=

# Prix Gemini au million de tokens. Laisser vide tant qu'ils n'ont pas été
# relevés sur la grille tarifaire officielle : le pipeline rapporte alors des
# tokens et aucun dollar, plutôt qu'un montant inventé.
GEMINI_PRICE_IN_PER_MTOK=
GEMINI_PRICE_OUT_PER_MTOK=

# --- Parallel ---
PARALLEL_API_KEY=

# --- Harnais de fixtures ---
# live    : appelle l'API réelle, ne stocke rien
# record  : appelle l'API réelle ET enregistre la réponse sur disque
# replay  : lit uniquement le disque, aucun appel réseau, aucun crédit consommé
FIXTURE_MODE=replay
FIXTURE_DIR=fixtures
