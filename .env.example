# Copier vers .env et remplir. .env est gitignoré.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=greenlight-xxxx
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Modèles : confirmer les identifiants exacts dans la doc Vertex AI au moment du build.
# Flash pour l'extraction (gros volume), Pro pour la classification (jugement).
GEMINI_MODEL_EXTRACT=gemini-3.1-flash
GEMINI_MODEL_CLASSIFY=gemini-3-pro

# --- Parallel ---
PARALLEL_API_KEY=

# --- Harnais de fixtures ---
# live    : appelle l'API réelle, ne stocke rien
# record  : appelle l'API réelle ET enregistre la réponse sur disque
# replay  : lit uniquement le disque, aucun appel réseau, aucun crédit consommé
FIXTURE_MODE=replay
FIXTURE_DIR=fixtures
